# Dockerfile.agent-runtime
#
# Packages the Rust agent runtime, bridges, and userspace components
# from thox-agentic-os (ThoxAOS) as an OCI image.
#
# This image is intended to run inside a ThoxTainer-managed VM
# or as a sidecar in ThoxOS Air / ThoxOS Edge environments.
#
# See docs/QUICKSTART-THOXOS-FAMILY.md for detailed usage.

FROM rust:1.86-bookworm AS builder

WORKDIR /build

# Clone or COPY the thox-agentic-os source
# For now we assume it's mounted or copied in CI
COPY . /build

RUN cargo build --release --workspace \
    --features production \
    -p thoxd \
    -p thoxsh \
    -p meshstack \
    -p nullclaw \
    -p thoxa

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 thoxaos

# Copy built binaries
COPY --from=builder /build/target/release/thoxd /usr/local/bin/
COPY --from=builder /build/target/release/thoxsh /usr/local/bin/
COPY --from=builder /build/target/release/thoxa /usr/local/bin/
COPY --from=builder /build/target/release/meshstackd /usr/local/bin/

# Copy default policy + launch profiles (signed in real releases)
COPY --from=builder /build/thox-policy/artifacts /etc/thox/policy/
COPY --from=builder /build/thox-release/artifacts /etc/thox/release/

USER thoxaos
WORKDIR /home/thoxaos

# Default to running the supervisor (thoxd)
ENTRYPOINT ["/usr/local/bin/thoxd"]
CMD ["--config", "/etc/thox/launch-profile.json"]
